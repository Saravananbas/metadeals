# Copy using `npm run env:setup`, which generates local-only random secrets.
# Never use these local defaults or development service accounts in production.
DATABASE_URL=postgresql://metadeals:REPLACE_LOCAL_PASSWORD@127.0.0.1:55432/metadeals?schema=public
POSTGRES_USER=metadeals
POSTGRES_PASSWORD=REPLACE_LOCAL_PASSWORD
POSTGRES_DB=metadeals
POSTGRES_PORT=55432

REDIS_URL=redis://:REPLACE_LOCAL_REDIS_PASSWORD@127.0.0.1:6380/0
REDIS_PASSWORD=REPLACE_LOCAL_REDIS_PASSWORD
REDIS_PORT=6380

# Auth configuration is prepared, but no login provider or auth route is enabled in M0.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
LOG_LEVEL=info

# Optional in M0. Supply credentials from your S3-compatible provider when enabled.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
