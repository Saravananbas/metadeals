# Copy using `npm run env:setup`, which generates local-only random secrets.
# Never use these local defaults or development service accounts in production.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://metadeals:REPLACE_LOCAL_PASSWORD@127.0.0.1:55432/metadeals?schema=public
DATABASE_SSL=false
POSTGRES_USER=metadeals
POSTGRES_PASSWORD=REPLACE_LOCAL_PASSWORD
POSTGRES_DB=metadeals
POSTGRES_PORT=55432

REDIS_URL=redis://:REPLACE_LOCAL_REDIS_PASSWORD@127.0.0.1:6380/0
REDIS_PASSWORD=REPLACE_LOCAL_REDIS_PASSWORD
REDIS_PORT=6380

# Local credentials auth: generate independent AUTH_SESSION_SECRET and TOTP key with env:setup.
NEXTAUTH_URL=http://localhost:4123
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
AUTH_BOOTSTRAP_EMAIL=saran.be.2005@gmail.com
AUTH_BOOTSTRAP_ENABLED=false
LOG_LEVEL=info

# Optional in M0. Supply credentials from your S3-compatible provider when enabled.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Customer sign-in. Existing NEXTAUTH_URL and admin routes remain unchanged.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# local writes only to .local/email-outbox. Production requires resend.
CUSTOMER_EMAIL_MODE=local
RESEND_API_KEY=
EMAIL_FROM=
# Enable only for explicit sample previews; live catalog takes precedence.
DEMO_DEALS_ENABLED=false


# Dev-only: skip admin login (ignored when NODE_ENV=production). Leave unset/false for QA and PROD.
AUTH_DISABLED_DEV=false

# Optional: leave REDIS_URL empty on shared hosting (rate limits/kill switch then live in-process).
# MEDIA_STORAGE=local stores images on disk in production; MEDIA_DIR should be outside the app folder.
MEDIA_STORAGE=
MEDIA_DIR=

# Telegram auto-post on publish (leave empty to disable). Add the bot to the group as admin and create a TELEGRAM destination with the chat id.
TELEGRAM_BOT_TOKEN=

# Nightly analytics rollup (hPanel cron calls POST /api/cron/analytics-rollup with header x-cron-secret). Use 24+ random characters.
ANALYTICS_CRON_SECRET=

# Community forum: master switch (off by default) and a read-only kill switch
COMMUNITY_ENABLED=false
COMMUNITY_WRITES_DISABLED=false
COMMUNITY_NEW_ACCOUNT_HOURS=24

# Contact email shown on the public privacy page (leave empty to hide)
PRIVACY_CONTACT_EMAIL=

# Admin portal is reachable only from these IP addresses (comma separated; IPv4 ranges like 203.0.113.0/24 allowed). Empty = no restriction.
ADMIN_ALLOWED_IPS=

# How many reverse proxies sit in front of the app (Hostinger: 1). The client address is taken that many entries from the RIGHT of x-forwarded-for.
TRUSTED_PROXY_HOPS=1
