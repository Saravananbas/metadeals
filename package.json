{
  "name": "metadeals4u",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev --port 4123",
    "build": "prisma generate && next build",
    "start": "next start --port 4123",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "infra:up": "docker compose up -d --wait",
    "infra:stop": "docker compose stop",
    "env:setup": "node scripts/setup-env.mjs",
    "auth:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-super-admin.ts",
    "auth:reset-link": "node --conditions=react-server --import tsx scripts/manual-password-reset.ts",
    "test:auth:integration": "node --conditions=react-server --import tsx scripts/auth-integration-test.ts",
    "test:deals:integration": "node --conditions=react-server --import tsx scripts/deals-integration-test.ts",
    "test:deals:http": "node --conditions=react-server --import tsx scripts/m3-http-test.ts",
    "test:affiliate:integration": "node --conditions=react-server --import tsx scripts/m4-affiliate-test.ts",
    "test:distribution:integration": "node --conditions=react-server --import tsx scripts/m5-distribution-test.ts",
    "test:scraper:integration": "node --conditions=react-server --import tsx scripts/scraper-integration-test.ts",
    "db:seed:deals": "node --conditions=react-server --import tsx scripts/seed-100-deals.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "argon2": "0.45.1",
    "bullmq": "6.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ioredis": "6.0.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
