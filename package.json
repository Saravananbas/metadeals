{
  "name": "metadeals4u",
  "version": "0.1.0",
  "private": true,
  "browserslist": ["chrome >= 100", "edge >= 100", "firefox >= 100", "safari >= 15.4", "ios_saf >= 15.4", "samsung >= 18"],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-with-extractor.mjs",
    "dev:host": "next dev --webpack --port 4123",
    "build": "npm run db:generate:all && next build --webpack",
    "start": "next start",
    "start:local": "next start --port 4123",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:watch": "node --conditions=react-server --import tsx --test --watch tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:security": "node --conditions=react-server --import tsx --test tests/security-regression.test.ts tests/admin-ip-proxy.test.ts",
    "perf:check": "node scripts/perf-check.mjs",
    "db:generate": "prisma generate",
    "db:generate:all": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.mariadb.prisma",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "apple:secret": "node scripts/apple-client-secret.mjs",
    "package:staging": "node scripts/package-staging.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "auth:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-super-admin.ts",
    "auth:reset-link": "node --conditions=react-server --import tsx scripts/manual-password-reset.ts",
    "test:auth:integration": "node --conditions=react-server --import tsx scripts/auth-integration-test.ts",
    "test:deals:integration": "node --conditions=react-server --import tsx scripts/deals-integration-test.ts",
    "test:deals:http": "node --conditions=react-server --import tsx scripts/m3-http-test.ts",
    "test:affiliate:integration": "node --conditions=react-server --import tsx scripts/m4-affiliate-test.ts",
    "test:distribution:integration": "node --conditions=react-server --import tsx scripts/m5-distribution-test.ts",
    "test:scraper:integration": "node --conditions=react-server --import tsx scripts/scraper-integration-test.ts",
    "media:to-s3": "node --conditions=react-server --import tsx scripts/migrate-media-to-s3.ts",
    "db:seed:deals": "node --conditions=react-server --import tsx scripts/seed-100-deals.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "argon2": "0.45.1",
    "bullmq": "6.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ioredis": "6.0.0",
    "jose": "4.15.9",
    "lucide-react": "1.66.0",
    "mariadb": "3.5.5",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
