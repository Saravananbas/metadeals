generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-mariadb"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  COMMUNITY_MODERATOR
}

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

enum AuthTokenPurpose {
  ACCOUNT_SETUP
  PASSWORD_RESET
  SUPER_ADMIN_BOOTSTRAP
}

// Identity foundation for the stable Auth.js / NextAuth Prisma adapter.
model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String?        @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole       @default(EDITOR)
  status              UserStatus     @default(PENDING_SETUP)
  passwordHash        String?        @db.VarChar(255)
  totpSecretEncrypted String?        @db.Text
  totpEnabledAt       DateTime?
  /// Staff suspension window. Blocked while suspendedFrom <= now < suspendedUntil; a null start means immediately.
  suspendedFrom       DateTime?
  suspendedUntil      DateTime?
  suspensionReason    String?        @db.VarChar(300)
  /// When true the person's checklist in StaffPermissionGrant replaces their role defaults, until customAccessUntil (null = no end).
  customAccess        Boolean        @default(false)
  customAccessUntil   DateTime?
  lastTotpStep        BigInt         @default(-1)
  accounts            Account[]
  sessions            Session[]
  authSessions        AuthSession[]
  recoveryCodes       RecoveryCode[]
  tokens              AuthToken[]    @relation("TokenTarget")
  createdTokens       AuthToken[]    @relation("TokenCreator")
  auditAsActor        AuditEvent[]   @relation("AuditActor")
  createdDeals        Deal[]         @relation("DealCreator")
  updatedDeals        Deal[]         @relation("DealUpdater")
  uploadedMedia       Media[]
  reviewedSubmissions CommunityDealSubmission[] @relation("SubmissionReviewer")
  forumReportsResolved ForumReport[] @relation("ForumReportResolver")
  forumActions ForumModerationAction[] @relation("ForumModerator")
  announcementsCreated   ForumAnnouncement[] @relation("AnnouncementCreator")
  announcementsPublished ForumAnnouncement[] @relation("AnnouncementPublisher")
  permissionGrants       StaffPermissionGrant[] @relation("GrantTarget")
  permissionGrantsMade   StaffPermissionGrant[] @relation("GrantGiver")
  /// Set only when a customer accepts a moderator invitation while signed in; email equality is never used as proof.
  linkedCustomerId       String?        @unique @db.VarChar(191)
  linkedCustomer         Customer?      @relation("StaffLinkedCustomer", fields: [linkedCustomerId], references: [id], onDelete: Restrict)
  moderatorAppointment   ModeratorAppointment? @relation("AppointmentStaff")
  appointmentsInvited    ModeratorAppointment[] @relation("AppointmentInviter")
  warningsIssued         MemberWarning[]     @relation("WarningIssuer")
  restrictionsIssued     MemberRestriction[] @relation("RestrictionIssuer")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([role, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthSession {
  id                String   @id @default(cuid())
  userId            String
  tokenHash         String   @unique @db.Char(64)
  createdAt         DateTime @default(now())
  lastActivityAt    DateTime @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  ipHash            String?  @db.Char(64)
  userAgent         String?  @db.VarChar(512)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AuthToken {
  id                    String           @id @default(cuid())
  tokenHash             String           @unique @db.Char(64)
  purpose               AuthTokenPurpose
  email                 String
  userId                String?
  role                  UserRole?
  createdById           String?
  passwordHash          String?          @db.VarChar(255)
  totpSecretEncrypted   String?          @db.Text
  emailDeliveryVerified Boolean          @default(false)
  createdAt             DateTime         @default(now())
  expiresAt             DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  revokedAt             DateTime?
  user                  User?            @relation("TokenTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy             User?            @relation("TokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([email, purpose, expiresAt])
  @@index([userId, purpose])
}

model AuthRateLimit {
  subjectHash String    @id @db.Char(64)
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
  @@index([lockedUntil])
}

model BootstrapState {
  id          String    @id
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   @db.VarChar(80)
  targetId  String?  @db.VarChar(128)
  success   Boolean
  requestId String?  @db.VarChar(64)
  ipHash    String?  @db.Char(64)
  userAgent String?  @db.VarChar(512)
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetId])
}

enum DealStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  EXPIRED
  ARCHIVED
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  deals     Deal[]
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Merchant {
  id             String           @id @default(cuid())
  slug           String           @unique @db.VarChar(100)
  name           String           @db.VarChar(100)
  websiteUrl     String           @db.VarChar(2048)
  affiliateHosts Json?
  deals          Deal[]
  options        PurchaseOption[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model AffiliateClick {
  id        String @id @default(cuid())
  dealId    String
  optionId  String?
  merchantId String
  channel   String @db.VarChar(30)
  actorHash String @db.Char(64)
  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
  @@index([merchantId, createdAt])
  @@index([actorHash, createdAt])
  @@index([createdAt])
}

model AffiliateTransaction {
  id              String @id @default(cuid())
  provider        String @db.VarChar(60)
  externalId      String @db.VarChar(120)
  dealId          String?
  status          String @db.VarChar(20)
  commissionMinor Int
  currency        String @default("INR") @db.Char(3)
  reportedAt      DateTime
  enteredById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([status, reportedAt])
}

model Media {
  id           String   @id @default(cuid())
  storageKey   String   @unique @db.VarChar(160)
  provider     String   @db.VarChar(10)
  mimeType     String   @db.VarChar(40)
  byteSize     Int
  width        Int
  height       Int
  alt          String   @db.VarChar(240)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  deals        Deal[]
  galleryImages DealGalleryImage[]
  createdAt    DateTime @default(now())
}

model Deal {
  id             String     @id @default(cuid())
  slug           String     @unique @db.VarChar(120)
  title          String     @db.VarChar(200)
  brand          String     @db.VarChar(100)
  description    String     @db.VarChar(2000)
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  merchantId     String
  merchant       Merchant   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  mediaId        String
  media          Media      @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  galleryImages  DealGalleryImage[]
  mrpMinor       Int
  priceMinor     Int
  currency       String     @default("INR") @db.Char(3)
  rating         Float?
  reviewCount    Int?
  viewCount      Int        @default(0)
  shareCount     Int        @default(0)
  ratingSource   String?    @db.VarChar(200)
  productUrl     String     @db.VarChar(2048)
  affiliateUrl   String?    @db.VarChar(2048)
  couponCode     String?    @db.VarChar(50)
  status         DealStatus @default(DRAFT)
  publishedAt    DateTime?
  startsAt       DateTime?
  expiresAt      DateTime?
  featured       Boolean    @default(false)
  trending       Boolean    @default(false)
  everPublished  Boolean    @default(false)
  version        Int        @default(1)
  createdById    String
  updatedById    String
  createdBy      User       @relation("DealCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User       @relation("DealUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  options        PurchaseOption[]
  candidates     DealCandidate[]
  priceObservations PriceObservation[]
  comments       DealComment[]
  videoReviews   DealVideoReview[]
  communitySubmission CommunityDealSubmission?
  savedBy         SavedDeal[]
  youtubeReviewStatus String   @default("NOT_REQUESTED") @db.VarChar(50)
  youtubeLastSearchedAt DateTime?

  @@index([status, publishedAt, id])
  @@index([categoryId, status, publishedAt])
  @@index([merchantId, status, publishedAt])
  @@index([expiresAt])
  @@index([featured, status, publishedAt])
  @@index([trending, status, publishedAt])
}

model PurchaseOption {
  id           String @id @default(cuid())
  dealId       String
  deal         Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  priceMinor   Int
  productUrl   String @db.VarChar(2048)
  affiliateUrl String? @db.VarChar(2048)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([dealId, merchantId])
}

model DealGalleryImage {
  id        String   @id @default(cuid())
  dealId    String
  mediaId   String
  position  Int
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([dealId, position])
  @@index([mediaId])
}

model Customer {
  id              String             @id @default(cuid())
  name            String
  email           String             @unique
  image           String?            @db.VarChar(1024)
  passwordHash    String?            @db.VarChar(255)
  sex             String?            @db.VarChar(20)
  dateOfBirth     DateTime?          @db.Date
  location        String?            @db.VarChar(100)
  submissions     CommunityDealSubmission[]
  forumProfile    ForumProfile?
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  identities      CustomerIdentity[]
  passwordResets  CustomerPasswordReset[]
  appTokens       CustomerAppToken[]
  linkedStaff     User?              @relation("StaffLinkedCustomer")
  moderatorAppointments ModeratorAppointment[] @relation("AppointmentCustomer")
  pushTokens      DevicePushToken[]
  preference      CustomerPreference?
  savedDeals      SavedDeal[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}
model CustomerIdentity {
  id         String   @id @default(cuid())
  customerId String
  provider   String
  subject    String
  email      String?
  name       String?
  avatarUrl  String?  @db.VarChar(1024)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([provider, subject])
  @@index([customerId])
}
model CustomerSignupChallenge {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String @db.VarChar(255)
  codeHash String @db.Char(64)
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  consumedAt DateTime?
  @@index([expiresAt])
}
/// One pending "forgot password" request: a six-digit code sent by email. Only a keyed hash of the code is stored.
model CustomerPasswordReset {
  id         String    @id
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  codeHash   String    @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([expiresAt])
}
model CustomerRateLimit {
  key String @id @db.Char(64)
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

enum DistributionPlatform {
  TELEGRAM
  WHATSAPP
}

enum PostStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model DistributionDestination {
  id            String               @id @default(cuid())
  platform      DistributionPlatform
  name          String               @db.VarChar(100)
  destinationId String               @db.VarChar(120)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  posts         DistributionPost[]

  @@unique([platform, destinationId])
}

model DistributionPost {
  id                String                  @id @default(cuid())
  dealId            String
  destinationId     String
  platform          DistributionPlatform
  status            PostStatus              @default(QUEUED)
  messageContent    String                  @db.Text
  externalMessageId String?                 @db.VarChar(120)
  errorMessage      String?                 @db.Text
  sentAt            DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  destination       DistributionDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([dealId, destinationId])
  @@index([status, createdAt])
}

enum CandidateStatus {
  DISCOVERED
  VALIDATING
  VERIFIED
  UNCERTAIN
  REJECTED
  PUBLISHED
}

model DealCandidate {
  id                 String          @id @default(cuid())
  sourceUrl          String          @db.VarChar(2048)
  sourcePlatform     String          @db.VarChar(60)
  externalId         String?         @db.VarChar(120)
  rawTitle           String          @db.VarChar(300)
  brand              String?         @db.VarChar(100)
  categorySlug       String          @db.VarChar(100)
  observedPriceMinor Int
  observedMrpMinor   Int
  currency           String          @default("INR") @db.Char(3)
  discountPercent    Int             @default(0)
  imageUrl           String?         @db.VarChar(2048)
  sellerName         String?         @db.VarChar(150)
  inStock            Boolean         @default(true)
  confidenceScore    Int             @default(0)
  status             CandidateStatus @default(DISCOVERED)
  rejectionReason    String?         @db.VarChar(500)
  rawData            String?         @db.Text
  dealId             String?
  deal               Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  priceObservations  PriceObservation[]

  @@index([status, createdAt])
  @@index([sourcePlatform, externalId])
  @@index([dealId])
}

model PriceObservation {
  id                 String         @id @default(cuid())
  dealId             String?
  deal               Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  candidateId        String?
  candidate          DealCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  merchantSlug       String         @db.VarChar(100)
  priceMinor         Int
  mrpMinor           Int
  currency           String         @default("INR") @db.Char(3)
  sourceUrl          String         @db.VarChar(2048)
  observedAt         DateTime       @default(now())

  @@index([merchantSlug, observedAt])
  @@index([dealId, observedAt])
  @@index([candidateId, observedAt])
}

enum ScraperJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ScraperJob {
  id             String           @id @default(cuid())
  connectorCode  String           @db.VarChar(60)
  status         ScraperJobStatus @default(RUNNING)
  itemsFound     Int              @default(0)
  itemsVerified  Int              @default(0)
  itemsPublished Int              @default(0)
  errorMessage   String?          @db.Text
  startedAt      DateTime         @default(now())
  completedAt    DateTime?

  @@index([connectorCode, startedAt])
}

model ProductExtractionLog {
  id               String   @id @default(cuid())
  adminUserId      String?
  retailer         String   @db.VarChar(60)
  originalUrl      String   @db.VarChar(2048)
  extractionStatus String   @db.VarChar(40)
  fieldsSummary    Json?
  sourceMethod     String   @db.VarChar(60)
  errorCode        String?  @db.VarChar(60)
  createdAt        DateTime @default(now())

  @@index([retailer, createdAt])
  @@index([adminUserId, createdAt])
}

model DealVideoReview {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  videoId         String   @db.VarChar(50)
  title           String   @db.VarChar(300)
  channelTitle    String   @db.VarChar(150)
  channelId       String?  @db.VarChar(100)
  thumbnailUrl    String   @db.VarChar(1000)
  publishedAt     DateTime?
  duration        String?  @db.VarChar(30)
  viewCount       Int      @default(0)
  likeCount       Int?
  language        String   @default("English") @db.VarChar(50)
  relevanceScore  Float    @default(0)
  rankingPosition Int      @default(1)
  isEmbeddable    Boolean  @default(true)
  isPinned        Boolean  @default(false)
  isActive        Boolean  @default(true)
  lastFetchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dealId, videoId])
  @@index([dealId, isActive, rankingPosition])
  @@index([dealId, language])
}

model YouTubeQuotaLedger {
  id               String   @id @default(cuid())
  endpoint         String   @db.VarChar(100)
  units            Int
  outcome          String   @db.VarChar(30)
  dealId           String?  @db.VarChar(100)
  canonicalProduct String?  @db.VarChar(255)
  adminUserId      String?  @db.VarChar(100)
  errorCategory    String?  @db.VarChar(100)
  errorMessage     String?  @db.VarChar(500)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([endpoint, createdAt])
  @@index([outcome, createdAt])
  @@index([dealId])
}

enum MerchantDirectoryStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

enum MerchantDirectoryVerification {
  VERIFIED
  UNVERIFIED
  NEEDS_REVIEW
}

model MerchantWebsiteDirectory {
  id                 String                        @id @default(cuid())
  merchantCode       String?                       @db.VarChar(50)
  name               String                        @db.VarChar(150)
  websiteUrl         String                        @db.VarChar(2048)
  domain             String                        @unique @db.VarChar(150)
  category           String                        @default("UNCLASSIFIED") @db.VarChar(100)
  categories         Json?
  productFocus       String?                       @db.VarChar(255)
  businessModel      String?                       @db.VarChar(100)
  description        String?                       @db.VarChar(2000)
  country            String                        @default("India") @db.VarChar(50)
  status             MerchantDirectoryStatus       @default(ACTIVE)
  verificationStatus MerchantDirectoryVerification @default(UNVERIFIED)
  logoMediaId        String?
  logoUrl            String?                       @db.VarChar(2048)
  source             String                        @default("EXCEL_IMPORT") @db.VarChar(100)
  notes              String?                       @db.VarChar(2000)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([verificationStatus])
  @@index([logoMediaId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// AI Deal Intelligence Foundation (M02 - Additive Data Models)
// -------------------------------------------------------------

model ProductMaster {
  id               String           @id @default(cuid())
  canonicalTitle   String           @db.VarChar(500)
  brand            String           @db.VarChar(150)
  categorySlug     String?          @db.VarChar(100)
  gtin             String?          @unique @db.VarChar(50)
  mpn              String?          @db.VarChar(100)
  modelNumber      String?          @db.VarChar(100)
  description      String?          @db.Text
  defaultImageId   String?          @db.VarChar(128)
  verifiedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  offers           ProductOffer[]

  @@index([brand, canonicalTitle])
  @@index([categorySlug])
  @@index([gtin])
}

model ProductVariant {
  id               String           @id @default(cuid())
  productId        String
  product          ProductMaster    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantKey       String           @db.VarChar(150) // e.g. "color:black|storage:128gb"
  title            String           @db.VarChar(500)
  color            String?          @db.VarChar(100)
  size             String?          @db.VarChar(50)
  storageCapacity  String?          @db.VarChar(50)
  condition        String           @default("NEW") @db.VarChar(50)
  asin             String?          @db.VarChar(20)
  fsn              String?          @db.VarChar(30)
  sku              String?          @db.VarChar(100)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  offers           ProductOffer[]
  observations     PriceObservationRecord[]

  @@unique([productId, variantKey])
  @@index([asin])
  @@index([fsn])
}

model ProductOffer {
  id               String           @id @default(cuid())
  productId        String
  product          ProductMaster    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  merchantSlug     String           @db.VarChar(60)
  sellerName       String?          @db.VarChar(150)
  sellerRating     Float?
  retailerUrl      String           @db.VarChar(2048)
  inStock          Boolean          @default(true)
  currentPricePaise Int
  mrpPaise         Int
  lastCheckedAt    DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([merchantSlug, inStock])
  @@index([productId, variantId])
}

model PriceObservationRecord {
  id               String           @id @default(cuid())
  variantId        String?
  variant          ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  merchantSlug     String           @db.VarChar(60)
  sellerName       String?          @db.VarChar(150)
  url              String           @db.VarChar(2048)
  mrpPaise         Int
  sellingPricePaise Int
  couponPricePaise Int?
  bankOfferPaise   Int?
  deliveryFeePaise Int              @default(0)
  effectivePricePaise Int
  currency         String           @default("INR") @db.Char(3)
  extractionMethod String           @db.VarChar(60)
  isAvailable      Boolean          @default(true)
  observedAt       DateTime         @default(now())

  @@index([variantId, observedAt])
  @@index([merchantSlug, observedAt])
}

enum SourceHealthState {
  HEALTHY
  DEGRADED
  SUSPENDED
}

model SourceHealthRecord {
  id                 String            @id @default(cuid())
  connectorCode      String            @unique @db.VarChar(60)
  state              SourceHealthState @default(HEALTHY)
  totalRequests      Int               @default(0)
  successfulRequests Int               @default(0)
  consecutiveFailures Int              @default(0)
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  lastFailureReason  String?           @db.VarChar(500)
  updatedAt          DateTime          @updatedAt
  createdAt          DateTime          @default(now())

  @@index([state])
}

enum PublicationAuthStatus {
  PENDING_APPROVAL
  APPROVED
  CLAIMED
  PUBLISHING
  PUBLISHED
  REJECTED
  EXPIRED
  RECOVERY_REQUIRED
}

model PublicationAuthorization {
  id                 String                @id @default(cuid())
  candidateId        String                @unique @db.VarChar(128)
  authorizedByAdmin  String?               @db.VarChar(100)
  approvalToken      String                @unique @db.VarChar(128)
  status             PublicationAuthStatus @default(PENDING_APPROVAL)
  isPriceErrorSuspected Boolean            @default(false)
  confidenceScore    Float
  attractivenessScore Float
  approvedAt         DateTime?
  publishedAt        DateTime?
  expiresAt          DateTime
  createdAt          DateTime              @default(now())

  @@index([status])
  @@index([expiresAt])
}

model ShadowCandidate {
  id                 String                @id @default(cuid())
  competitorSource   String                @db.VarChar(100)
  sourceUrl          String                @db.VarChar(2048)
  title              String                @db.VarChar(500)
  pricePaise         Int
  mrpPaise           Int
  brand              String?               @db.VarChar(150)
  matchedProductId   String?               @db.VarChar(128)
  matchedVariantId   String?               @db.VarChar(128)
  dealScore          Float                 @default(0)
  discoveredAt       DateTime              @default(now())

  @@index([competitorSource, discoveredAt])
  @@index([matchedProductId])
}

model DealLifecycleEvent {
  id                 String                @id @default(cuid())
  dealId             String                @db.VarChar(128)
  eventType          String                @db.VarChar(60) // OUT_OF_STOCK, PRICE_DROP, PRICE_INCREASE, EXPIRED, RESTORED
  previousState      Json?
  newState           Json?
  triggeredBy        String                @db.VarChar(100)
  recordedAt         DateTime              @default(now())

  @@index([dealId, recordedAt])
  @@index([eventType, recordedAt])
}

model DealComment {
  id           String   @id @default(cuid()) @db.VarChar(191)
  dealId       String   @db.VarChar(191)
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorName   String   @default("Guest") @db.VarChar(80)
  content      String   @db.VarChar(1000)
  authorIpHash String?  @db.Char(64)
  createdAt    DateTime @default(now())

  @@index([dealId, createdAt])
  @@index([authorIpHash, createdAt])
}



model AnalyticsSession {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  activeSeconds Int      @default(0)
  pageCount     Int      @default(0)
  entryPath     String   @db.VarChar(300)
  exitPath      String   @db.VarChar(300)
  referrerHost  String?  @db.VarChar(150)
  utmSource     String?  @db.VarChar(100)
  utmMedium     String?  @db.VarChar(100)
  utmCampaign   String?  @db.VarChar(100)
  channel       String?  @db.VarChar(30)
  deviceType    String   @db.VarChar(20)
  browser       String   @db.VarChar(30)
  os            String   @db.VarChar(30)
  returning     Boolean  @default(false)
  /// Keyed hash of the long-lived visitor cookie; only set for visitors who accepted analytics.
  visitorKey    String?  @db.VarChar(32)
  customerId    String?  @db.VarChar(191)
  events        AnalyticsEvent[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([customerId])
  @@index([visitorKey, startedAt])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  sessionId    String?
  visitorHash  String   @db.VarChar(32)
  type         String   @db.VarChar(30)
  path         String   @db.VarChar(300)
  pageType     String   @db.VarChar(20)
  dealId       String?  @db.VarChar(191)
  merchantId   String?  @db.VarChar(191)
  categoryId   String?  @db.VarChar(191)
  referrerHost String?  @db.VarChar(150)
  channel      String?  @db.VarChar(30)
  deviceType   String?  @db.VarChar(20)
  durationSec  Int      @default(0)
  createdAt    DateTime @default(now())
  session      AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([dealId, createdAt])
  @@index([merchantId, createdAt])
  @@index([sessionId, createdAt])
  @@index([pageType, createdAt])
}

model AnalyticsDaily {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  dimension     String   @db.VarChar(20)
  key           String   @db.VarChar(191)
  views         Int      @default(0)
  visitors      Int      @default(0)
  sessions      Int      @default(0)
  clicks        Int      @default(0)
  activeSeconds Int      @default(0)

  @@unique([date, dimension, key])
  @@index([dimension, date])
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model CommunityDealSubmission {
  id              String           @id @default(cuid())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          SubmissionStatus @default(PENDING_REVIEW)
  title           String           @db.VarChar(200)
  brand           String?          @db.VarChar(100)
  description     String           @db.VarChar(2000)
  productUrl      String           @db.VarChar(2048)
  urlHash         String           @db.Char(64)
  merchantName    String?          @db.VarChar(100)
  categoryHint    String?          @db.VarChar(100)
  priceMinor      Int
  mrpMinor        Int?
  couponCode      String?          @db.VarChar(50)
  imageKey        String           @db.VarChar(160)
  imageProvider   String           @db.VarChar(10)
  imageMime       String           @db.VarChar(40)
  imageBytes      Int
  imageWidth      Int
  imageHeight     Int
  version         Int              @default(1)
  resubmissions   Int              @default(0)
  submittedAt     DateTime         @default(now())
  reviewedById    String?
  reviewedBy      User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?          @db.VarChar(500)
  dealId          String?          @unique
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([customerId, urlHash])
  @@index([status, submittedAt])
  @@index([customerId, status])
}

enum ForumPostType {
  DEAL
  DISCUSSION
  QUESTION
}

enum ForumContentStatus {
  PENDING_REVIEW
  PUBLISHED
  REMOVED
  DELETED
}

enum ForumMemberStatus {
  ACTIVE
  SUSPENDED
}

enum ForumReportTarget {
  POST
  COMMENT
  PROFILE
}

enum ForumReportCategory {
  SPAM
  SCAM
  HARASSMENT
  HATE
  ILLEGAL
  PRIVACY
  IMPERSONATION
  OFF_TOPIC
  OTHER
}

enum ForumReportStatus {
  OPEN
  RESOLVED
  DISMISSED
  ESCALATED
}

model ForumCommunity {
  id             String   @id @default(cuid())
  slug           String   @unique @db.VarChar(40)
  name           String   @db.VarChar(60)
  description    String   @db.VarChar(300)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  requiresReview Boolean  @default(false)
  posts          ForumPost[]
  follows        ForumFollow[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ForumProfile {
  id               String            @id @default(cuid())
  customerId       String            @unique
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  handle           String            @unique @db.VarChar(30)
  bio              String?           @db.VarChar(280)
  displayName      String?           @db.VarChar(60)
  location         String?           @db.VarChar(80)
  lastSeenAt       DateTime?
  /// Set by staff only (never by the member). Shown as the Verified member badge.
  verifiedAt       DateTime?
  verifiedById     String?           @db.VarChar(191)
  followers        ForumMemberFollow[] @relation("MemberFollowed")
  warnings         MemberWarning[]     @relation("WarningTarget")
  restrictions     MemberRestriction[] @relation("RestrictionTarget")
  appeals          ModerationAppeal[]  @relation("AppealAppellant")
  following        ForumMemberFollow[] @relation("MemberFollower")
  status           ForumMemberStatus @default(ACTIVE)
  suspendedUntil   DateTime?
  suspensionReason String?           @db.VarChar(300)
  avatarKey        String?           @db.VarChar(160)
  avatarProvider   String?           @db.VarChar(10)
  dmThreadsLow     DmThread[]        @relation("DmThreadLow")
  dmThreadsHigh    DmThread[]        @relation("DmThreadHigh")
  dmMessages       DmMessage[]       @relation("DmSender")
  dmBlocksMade     DmBlock[]         @relation("DmBlocker")
  dmBlocksReceived DmBlock[]         @relation("DmBlocked")
  posts            ForumPost[]
  comments         ForumComment[]
  postVotes        ForumPostVote[]
  commentVotes     ForumCommentVote[]
  postImages       ForumPostImage[]
  draft            ForumPostDraft?
  notifications    ForumNotification[] @relation("NotificationRecipient")
  notificationsMade ForumNotification[] @relation("NotificationActor")
  saves            ForumSave[]
  postLikes        ForumPostLike[]
  commentLikes     ForumCommentLike[]
  follows          ForumFollow[]
  reportsMade      ForumReport[]     @relation("ForumReporter")
  reportsAgainst   ForumReport[]     @relation("ForumReportedProfile")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ForumPost {
  id            String             @id @default(cuid())
  slug          String             @unique @db.VarChar(120)
  communityId   String
  community     ForumCommunity     @relation(fields: [communityId], references: [id], onDelete: Restrict)
  authorId      String
  author        ForumProfile       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  type          ForumPostType
  title         String             @db.VarChar(200)
  body          String             @db.Text
  url           String?            @db.VarChar(2048)
  urlHash       String?            @db.Char(64)
  merchantName  String?            @db.VarChar(100)
  priceMinor    Int?
  mrpMinor      Int?
  couponCode    String?            @db.VarChar(50)
  contentHash   String             @db.Char(64)
  status        ForumContentStatus @default(PUBLISHED)
  locked        Boolean            @default(false)
  score         Int                @default(0)
  commentCount  Int                @default(0)
  viewCount     Int                @default(0)
  likeCount     Int                @default(0)
  bodyHtml      String?            @db.Text
  notifyReplies Boolean            @default(false)
  removalReason String?            @db.VarChar(300)
  version       Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  publishedAt   DateTime?
  editedAt      DateTime?
  comments      ForumComment[]
  votes         ForumPostVote[]
  saves         ForumSave[]
  images        ForumPostImage[]
  likes         ForumPostLike[]
  reports       ForumReport[]

  @@index([status, publishedAt, id])
  @@index([communityId, status, publishedAt])
  @@index([status, score, publishedAt])
  @@index([authorId, createdAt])
  @@index([status, commentCount, publishedAt])
  @@index([status, viewCount, publishedAt])
  @@index([urlHash])
  @@index([authorId, contentHash])
}

model ForumComment {
  id            String             @id @default(cuid())
  postId        String
  post          ForumPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        ForumProfile       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentId      String?
  parent        ForumComment?      @relation("ForumCommentTree", fields: [parentId], references: [id], onDelete: Restrict)
  replies       ForumComment[]     @relation("ForumCommentTree")
  depth         Int                @default(0)
  body          String             @db.Text
  status        ForumContentStatus @default(PUBLISHED)
  score         Int                @default(0)
  likeCount     Int                @default(0)
  bodyHtml      String?            @db.Text
  removalReason String?            @db.VarChar(300)
  version       Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  editedAt      DateTime?
  votes         ForumCommentVote[]
  likes         ForumCommentLike[]
  reports       ForumReport[]

  @@index([postId, likeCount])
  @@index([postId, parentId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model ForumPostVote {
  id        String       @id @default(cuid())
  postId    String
  post      ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  profile   ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([postId, profileId])
  @@index([profileId])
}

model ForumCommentVote {
  id        String       @id @default(cuid())
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId String
  profile   ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([commentId, profileId])
  @@index([profileId])
}

/// A like is separate from a vote (votes rank content, likes only say "I liked this"); one per member and item.
model ForumPostLike {
  id        String       @id @default(cuid())
  postId    String
  post      ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  profile   ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([postId, profileId])
  @@index([profileId])
}

model ForumCommentLike {
  id        String       @id @default(cuid())
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId String
  profile   ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([commentId, profileId])
  @@index([profileId])
}

model ForumSave {
  id        String       @id @default(cuid())
  postId    String
  post      ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String
  profile   ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([postId, profileId])
  @@index([profileId, createdAt])
}

model ForumFollow {
  id          String         @id @default(cuid())
  communityId String
  community   ForumCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profileId   String
  profile     ForumProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([communityId, profileId])
  @@index([profileId])
}

/// Pictures of a discussion (JPEG, PNG or WebP re-encoded to WebP). postId stays empty while the author is still composing.
model ForumPostImage {
  id         String       @id @default(cuid())
  postId     String?
  post       ForumPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId  String
  profile    ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  position   Int          @default(0)
  storageKey String       @db.VarChar(160)
  provider   String       @db.VarChar(10)
  width      Int
  height     Int
  bytes      Int
  createdAt  DateTime     @default(now())

  @@index([postId, position])
  @@index([profileId, postId, createdAt])
}

/// One unfinished discussion per member, private to them.
model ForumPostDraft {
  id        String       @id @default(cuid())
  profileId String       @unique
  profile   ForumProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// A notice for a member (someone replied, or a moderator acted). Post title and link are copied in so the list needs no joins; moderators are never named.
model ForumNotification {
  id          String        @id @default(cuid())
  recipientId String
  recipient   ForumProfile  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       ForumProfile? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String        @db.VarChar(30)
  postId      String
  postSlug    String        @db.VarChar(120)
  postTitle   String        @db.VarChar(200)
  commentId   String?
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([createdAt])
}

/// Official announcements. Publicly they always appear as "MetaDeals4U Team"; the staff member who wrote and published each one is kept here (and in the audit log), never shown to members.
model ForumAnnouncement {
  id            String    @id @default(cuid())
  slug          String    @unique @db.VarChar(120)
  title         String    @db.VarChar(200)
  body          String    @db.Text
  bodyHtml      String?   @db.Text
  status        String    @default("DRAFT") @db.VarChar(12)
  createdById   String
  createdBy     User      @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedById String?
  publishedBy   User?     @relation("AnnouncementPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  version       Int       @default(1)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
}

/// A permission granted to one staff member on top of their role (for example announcement:publish for an editor).
model StaffPermissionGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("GrantTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission  String   @db.VarChar(60)
  grantedById String?
  grantedBy   User?    @relation("GrantGiver", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([userId, permission])
}

model ForumReport {
  id              String              @id @default(cuid())
  reporterId      String
  reporter        ForumProfile        @relation("ForumReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  targetType      ForumReportTarget
  postId          String?
  post            ForumPost?          @relation(fields: [postId], references: [id], onDelete: Restrict)
  commentId       String?
  comment         ForumComment?       @relation(fields: [commentId], references: [id], onDelete: Restrict)
  targetProfileId String?
  targetProfile   ForumProfile?       @relation("ForumReportedProfile", fields: [targetProfileId], references: [id], onDelete: Restrict)
  category        ForumReportCategory
  details         String?             @db.VarChar(500)
  status          ForumReportStatus   @default(OPEN)
  version         Int                 @default(1)
  resolvedById    String?
  resolvedBy      User?               @relation("ForumReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolution      String?             @db.VarChar(300)
  createdAt       DateTime            @default(now())

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, targetProfileId])
  @@index([status, createdAt])
  @@index([postId])
  @@index([commentId])
}

/// Append-only moderation history. Target ids are plain strings on purpose so evidence outlives the content it refers to.
model ForumModerationAction {
  id            String   @id @default(cuid())
  actorId       String
  actor         User     @relation("ForumModerator", fields: [actorId], references: [id], onDelete: Restrict)
  action        String   @db.VarChar(40)
  targetType    String   @db.VarChar(12)
  postId        String?
  commentId     String?
  profileId     String?
  reason        String   @db.VarChar(500)
  correlationId String   @db.VarChar(36)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([postId])
  @@index([profileId])
}

enum DmThreadStatus {
  REQUESTED
  ACCEPTED
  DECLINED
}

model DmThread {
  id            String          @id @default(cuid())
  profileLowId  String
  profileLow    ForumProfile    @relation("DmThreadLow", fields: [profileLowId], references: [id], onDelete: Cascade)
  profileHighId String
  profileHigh   ForumProfile    @relation("DmThreadHigh", fields: [profileHighId], references: [id], onDelete: Cascade)
  requestedById String
  status        DmThreadStatus  @default(REQUESTED)
  lastMessageAt DateTime        @default(now())
  lowReadAt     DateTime?
  highReadAt    DateTime?
  lowDeliveredAt  DateTime?
  highDeliveredAt DateTime?
  lowMutedAt      DateTime?
  highMutedAt     DateTime?
  lowArchivedAt   DateTime?
  highArchivedAt  DateTime?
  /// "Delete conversation" only hides it for that member: messages up to this moment are no longer shown to them.
  lowClearedAt    DateTime?
  highClearedAt   DateTime?
  createdAt     DateTime        @default(now())
  messages      DmMessage[]

  @@unique([profileLowId, profileHighId])
  @@index([profileLowId, lastMessageAt])
  @@index([profileHighId, lastMessageAt])
}

model DmMessage {
  id        String       @id @default(cuid())
  threadId  String
  thread    DmThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    ForumProfile @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String       @db.Text
  /// TEXT, DEAL or DISCUSSION. For a share, refId is the deal or discussion id and the card is built from the live record.
  kind      String       @default("TEXT") @db.VarChar(12)
  refId     String?      @db.VarChar(191)
  /// Chosen by the sending device so a retried send is stored only once.
  clientId  String?      @db.VarChar(40)
  deleted   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@unique([senderId, clientId])
  @@index([threadId, createdAt])
}

model DmBlock {
  id        String       @id @default(cuid())
  blockerId String
  blocker   ForumProfile @relation("DmBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   ForumProfile @relation("DmBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Staff see a message only when a participant reports it; the text is copied here at that moment.
model DmReport {
  id                String              @id @default(cuid())
  reporterId        String
  reportedProfileId String
  threadId          String
  messageId         String
  category          ForumReportCategory
  details           String?             @db.VarChar(500)
  snapshot          String              @db.VarChar(2000)
  status            ForumReportStatus   @default(OPEN)
  version           Int                 @default(1)
  resolvedById      String?
  resolvedAt        DateTime?
  resolution        String?             @db.VarChar(300)
  createdAt         DateTime            @default(now())

  @@unique([reporterId, messageId])
  @@index([status, createdAt])
}

/// Sign-in token for the native apps. Only its SHA-256 is stored; the app keeps the token in the device's secure storage.
model CustomerAppToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  /// Refresh token (hash only). It is replaced on every use; the previous one is kept so a replayed old token ends the whole sign-in.
  refreshHash        String?  @unique @db.Char(64)
  prevRefreshHash    String?  @db.Char(64)
  refreshExpiresAt   DateTime?
  device     String?   @db.VarChar(80)
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// One member following another (public: shown as follower counts).
model ForumMemberFollow {
  id         String       @id @default(cuid())
  followerId String
  follower   ForumProfile @relation("MemberFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followedId String
  followed   ForumProfile @relation("MemberFollowed", fields: [followedId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([followerId, followedId])
  @@index([followedId])
}

/// A phone registered for push alerts (FCM token; it also reaches iPhones through Firebase). Alerts are sent only when a provider is configured.
model DevicePushToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   String   @db.VarChar(10)
  token      String   @unique @db.VarChar(255)
  device     String?  @db.VarChar(80)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([customerId])
}

/// A customer invited to moderate. The invitation token is single use and stored only as a hash. Status: INVITED, PROBATION, CONFIRMED, REVOKED, DECLINED.
model ModeratorAppointment {
  id                  String    @id @default(cuid())
  customerId          String
  customer            Customer  @relation("AppointmentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  invitedById         String
  invitedBy           User      @relation("AppointmentInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  staffUserId         String?   @unique
  staffUser           User?     @relation("AppointmentStaff", fields: [staffUserId], references: [id], onDelete: Restrict)
  status              String    @default("INVITED") @db.VarChar(12)
  inviteHash          String?   @unique @db.Char(64)
  inviteExpiresAt     DateTime?
  inviteNote          String?   @db.VarChar(300)
  guidelinesVersion   String?   @db.VarChar(20)
  guidelinesAcceptedAt DateTime?
  acceptedAt          DateTime?
  probationEndsAt     DateTime?
  extensions          Int       @default(0)
  confirmedAt         DateTime?
  revokedAt           DateTime?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  events              ModeratorAppointmentEvent[]

  @@index([customerId, status])
  @@index([status])
}

/// Append-only history of an appointment (invited, accepted, extended, confirmed, revoked) with the actor and the stated reason.
model ModeratorAppointmentEvent {
  id            String               @id @default(cuid())
  appointmentId String
  appointment   ModeratorAppointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actorId       String?              @db.VarChar(191)
  action        String               @db.VarChar(30)
  reason        String?              @db.VarChar(300)
  createdAt     DateTime             @default(now())

  @@index([appointmentId, createdAt])
}

/// A private warning to a member. The member sees the reason, never which moderator issued it.
model MemberWarning {
  id         String       @id @default(cuid())
  profileId  String
  profile    ForumProfile @relation("WarningTarget", fields: [profileId], references: [id], onDelete: Restrict)
  issuedById String
  issuedBy   User         @relation("WarningIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  reason     String       @db.VarChar(300)
  postId     String?      @db.VarChar(191)
  commentId  String?      @db.VarChar(191)
  status     String       @default("ACTIVE") @db.VarChar(10)
  createdAt  DateTime     @default(now())

  @@index([profileId, createdAt])
}

/// A time-limited ban on posting (discussions, comments, replies, community deal submissions). Never touches ForumProfile.status.
model MemberRestriction {
  id           String       @id @default(cuid())
  profileId    String
  profile      ForumProfile @relation("RestrictionTarget", fields: [profileId], references: [id], onDelete: Restrict)
  scope        String       @default("POSTING") @db.VarChar(12)
  startsAt     DateTime     @default(now())
  expiresAt    DateTime
  reason       String       @db.VarChar(300)
  issuedById   String
  issuedBy     User         @relation("RestrictionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedByRole String       @db.VarChar(24)
  postId       String?      @db.VarChar(191)
  commentId    String?      @db.VarChar(191)
  reportId     String?      @db.VarChar(191)
  revokedAt    DateTime?
  revokedById  String?      @db.VarChar(191)
  revokeReason String?      @db.VarChar(300)
  createdAt    DateTime     @default(now())

  @@index([profileId, expiresAt])
}

/// A member's appeal against a warning, restriction or content action. Decided by an administrator who did not take the action.
model ModerationAppeal {
  id              String       @id @default(cuid())
  profileId       String
  profile         ForumProfile @relation("AppealAppellant", fields: [profileId], references: [id], onDelete: Restrict)
  targetType      String       @db.VarChar(12)
  targetId        String       @db.VarChar(191)
  originalActorId String       @db.VarChar(191)
  message         String       @db.VarChar(1000)
  status          String       @default("OPEN") @db.VarChar(12)
  decidedById     String?      @db.VarChar(191)
  decidedAt       DateTime?
  decisionNote    String?      @db.VarChar(500)
  version         Int          @default(1)
  createdAt       DateTime     @default(now())

  @@unique([profileId, targetType, targetId])
  @@index([status, createdAt])
}

/// A redacted pointer to content a moderator hid as sensitive. It holds no content; only administrators can open the hidden item.
model ModerationEscalation {
  id          String    @id @default(cuid())
  targetType  String    @db.VarChar(10)
  targetId    String    @db.VarChar(191)
  category    String    @db.VarChar(30)
  createdById String    @db.VarChar(191)
  status      String    @default("OPEN") @db.VarChar(10)
  handledById String?   @db.VarChar(191)
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

/// Member's own notification and display choices (one row per member, created on first save). Nothing here is sent anywhere by itself: senders must check it.
model CustomerPreference {
  customerId   String   @id
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealAlerts   Boolean  @default(true)
  emailUpdates Boolean  @default(true)
  /// IMMEDIATE, DAILY, WEEKLY or OFF
  frequency    String   @default("IMMEDIATE") @db.VarChar(10)
  /// Comma-separated category slugs
  categorySlugs String? @db.VarChar(1000)
  updatedAt    DateTime @updatedAt
}

/// A deal the member bookmarked (server-side, so it follows them across devices).
model SavedDeal {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, dealId])
  @@index([customerId, createdAt])
}
